<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationIcon>wwwroot\favicon.ico</ApplicationIcon>
        <UseRazorSourceGenerator>true</UseRazorSourceGenerator>
        <EnableCompressionInStaticWebAssets>false</EnableCompressionInStaticWebAssets>
    </PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<RunAOTCompilation>false</RunAOTCompilation>
		<WasmNativeBuild>false</WasmNativeBuild>
		<PublishTrimmed>false</PublishTrimmed>
		<InvariantGlobalization>false</InvariantGlobalization>
	</PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Blazor.SubtleCrypto" Version="9.0.0" />
        <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
        <PackageReference Include="BlazorMonaco" Version="3.3.0" />
        <PackageReference Include="BlazorStack" Version="1.0.5" />
        <PackageReference Include="Bromix.MudBlazor.MaterialDesignIcons" Version="7.4.47.56" />
        <PackageReference Include="CodeBeam.MudBlazor.Extensions" Version="8.2.4" />
        <PackageReference Include="Howler.Blazor" Version="0.10.0"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.3" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.3" PrivateAssets="all" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="9.0.3" />
        <PackageReference Include="MudBlazor" Version="8.11.0" />
        <PackageReference Include="MudBlazor.Extensions" Version="8.9.0" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <PackageReference Include="Serilog" Version="4.3.0" />
        <PackageReference Include="Serilog.Enrichers.Context" Version="4.6.5" />
        <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.2" />
        <PackageReference Include="Serilog.Sinks.BrowserConsole" Version="8.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
        <PackageReference Include="Toolbelt.Blazor.I18nText" Version="14.0.1" />
        <PackageReference Include="xunit.assert" Version="2.5.3" />
        <PackageReference Include="Z.Blazor.Diagrams" Version="3.0.3" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\res\anim\other\" />
    </ItemGroup>

    <PropertyGroup>
        <WarningLevel>0</WarningLevel>
    </PropertyGroup>

    <Import Project="..\OmegaExplorer.Shared\OmegaExplorer.Shared.projitems" Label="Shared"/>
</Project>
