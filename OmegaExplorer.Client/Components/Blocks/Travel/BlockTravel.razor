@if (Distance > 0 || ForceShow)
{
    @if (LeftArrow)
    {
        <BlockTravelArrow Distance="Distance" Delay="Delay"></BlockTravelArrow>
    }

    <MudPaper Outlined="true" Class="pa-2 ma-2">
        <h3>@Title</h3>
    </MudPaper>

    @if (RightArrow)
    {
        <BlockTravelArrow Distance="Distance" Delay="Delay"></BlockTravelArrow>
    }   
}

@code {

    [Parameter]
    public string Title { get; set; } = "Title";

    [Parameter]
    public int Distance { get; set; }

    [Parameter]
    public int Delay { get; set; }

    [Parameter]
    public bool LeftArrow { get; set; } = true;

    [Parameter]
    public bool RightArrow { get; set; } = false;

    [Parameter]
    public bool ForceShow  { get; set; } = false;
}