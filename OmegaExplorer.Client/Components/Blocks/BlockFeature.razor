<MudCard Class="pa-2 ma-2">
	<MudStack AlignItems="AlignItems.Center" Row="true">
		<MudText>@IconText</MudText>
		<MudStack Spacing="0">
			<MudText><b>@Title</b></MudText>
			<MudText>@Description</MudText>
		</MudStack>
	</MudStack>
</MudCard>

@code {
	[Parameter]
    public string Title { get; set; } = "Feature Block";

	[Parameter] 
    public string Description { get; set; } = "This is a feature block description.";
	
	[Parameter]
    public string IconText { get; set; } = "🚀";
}