@using OmegaExplorer.Client.Utilities.Resources
@using OmegaExplorer.Server.Extensions
<MudCard class="ma-2 pa-2" Outlined="true" Style="max-height: 100px; max-width: 100px">
    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center">
        <MudImage Height="30" Width="30"
                  Src="@ResourceImage.GetImageSpeciesPortrait(SpeciesData.Species.Index, 0)"></MudImage>
        
        <MudStack Spacing="0" AlignItems="AlignItems.Center" Justify="Justify.Center">
            <MudText Typo="Typo.body2"><b>@SpeciesData.Species.Name</b></MudText>
            <MudText Typo="Typo.subtitle2">@SpeciesData.Amount.Humanify()</MudText>
        </MudStack>
    </MudStack>

</MudCard>
@code {
    [Parameter]
    public ResponseSpeciesAmount SpeciesData { get; set; }
}