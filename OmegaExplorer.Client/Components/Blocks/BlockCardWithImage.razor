<MudCard Style="max-height: 350px; max-width: 200px" Class="ma-2 pa-2 hoverable" @onclick="OnClick" Disabled="@Disabled">
    <MudCardMedia Image="@Image" Height="140"/>
    
    @if (Disabled)
    {
        <MudText Color="Color.Error">
            @DisabledText
        </MudText>
    }

    <MudText Typo="Typo.h6" Align="Align.Center" Class="mt-2">
        @Title
    </MudText>
</MudCard>

@code {

    [Parameter]
    public string Title { get; set; } = "Aeon";

    [Parameter]
    public EventCallback OnClick { get; set; }

    [Parameter]
    public string Image { get; set; } = string.Empty;
    
    [Parameter]
    public bool Disabled { get; set; } = false;
    
    [Parameter]
    public string DisabledText { get; set; } = string.Empty;

}