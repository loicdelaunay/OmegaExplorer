<div class="hover-group">
    <div class="hover-element force-center-pivot">
        @Content
    </div>

    <div class="hover-active force-center-pivot">
        @HoverContent
    </div>
</div>

@code {

    [Parameter]
    public RenderFragment Content { get; set; }

    [Parameter]
    public RenderFragment HoverContent { get; set; }
}