@using OmegaExplorer.Client.Components.Diagram.Nodes.Models
@using OmegaExplorer.Client.Models.Card.Definition
@using OmegaExplorer.Client.Utilities.Extensions

@if(Node != null)
{
    <ContentHover>
        <Content>
            <MudStack>
                @if (Node.StarSystem != null)
                {
                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center">
                        <PreviewSystem StarSystem="Node.StarSystem" Height="@GetPreviewSize"></PreviewSystem>
                        <MudPaper Class="pa-2">
                            <MudStack Spacing="0">
                                <MudText><b>@Node.StarSystem.Name</b></MudText>
                                <MudText Typo="Typo.caption">@Node.StarSystem.StarSystemType</MudText>
                                @if (Node.StarSystem.IsOwner())
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">Owned</MudChip>
                                }
                            </MudStack>
                        </MudPaper>
                    </MudStack>

                    @if (Node.Spaceships.Any())
                    {
                        <MudPaper Class="pa-2">
                            <MudText>Spaceships : @Node.Spaceships.Count</MudText>
                        </MudPaper>
                    }
                }
                else if (Node.Spaceships != null && Node.Spaceships.Any())
                {
                    ResponseSpaceship spaceship = Node.Spaceships.First();

                    <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center">
                        <PreviewSpaceship Spaceship="spaceship"></PreviewSpaceship>
                        <MudPaper Class="pa-2">
                            <MudStack Spacing="0">
                                <MudText><b>@spaceship.Name</b></MudText>
                                @if (spaceship.IsOwner())
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">Owned</MudChip>
                                }
                            </MudStack>
                        </MudPaper>
                    </MudStack>
                }
            </MudStack>
        </Content>
        <HoverContent>
            <MudTabs Elevation="0" Style="min-height:  600px !important;" Rounded="true" ApplyEffectsToContainer="true"
                     PanelClass="pa-6" Centered="true">
                @if (Node.StarSystem != null)
                {
                    <MudTabPanel Text="System">
                        @if (Node.StarSystem != null)
                        {
                            CardDefinitionStarSystem? definition = GetCardDefinitionStarSystem();

                            if (definition != null)
                            {
                                <Card Hoverable="false" Definition="@definition"></Card>
                            }
                        }
                    </MudTabPanel>
                }

                @* If exist spaceship activate UI *@
                @if (Node.Spaceships.Any())
                {
                    @* UI to manage multiple spaceships *@
                    @if (Node.Spaceships.Count > 1)
                    {
                        <MudTabPanel Text="Spaceships">
                            <MudStack>
                                <MudSelect T="ResponseSpaceship" @bind-Value="_selectedSpaceship"
                                           Variant="Variant.Outlined"
                                           Label="Spaceships">
                                    @foreach (ResponseSpaceship spaceship in Node.Spaceships)
                                    {
                                        <MudSelectItem Value="spaceship">@spaceship.Name</MudSelectItem>
                                    }
                                </MudSelect>

                                @if (_selectedSpaceship != null)
                                {
                                    <Card Hoverable="false" Definition="new CardDefinitionSpaceship(_selectedSpaceship)"></Card>
                                }
                            </MudStack>
                        </MudTabPanel>
                    }
                    @* UI to manage one spaceship *@
                    else
                    {
                        <Card Hoverable="false" Definition="@(new CardDefinitionSpaceship(@Node.Spaceships.First()))"></Card>
                    }
            }
        </MudTabs>
    </HoverContent>
</ContentHover>
}

@code {

    [Parameter]
    public NodeModelMapStarClusterSearch? Node { get; set; }

    private int GetPreviewSize => Node.StarSystem.Size * 10;

    private CardDefinitionStarSystem? GetCardDefinitionStarSystem()
    {
        if (Node == null)
        {
            return null;
        }

        if(Node.StarSystem == null)
        {
            return null;
        }

        return new CardDefinitionStarSystem(Node.StarSystem);
    }

    private ResponseSpaceship? _selectedSpaceship;
}

