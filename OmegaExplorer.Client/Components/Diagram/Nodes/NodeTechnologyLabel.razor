@using OmegaExplorer.Client.Components.Diagram.Nodes.Models
<MudCard Style="width: 600px; height: 200px" Class="pa-2 ma-2" Outlined>
    <MudStack AlignItems="AlignItems.Start" Justify="Justify.FlexStart" Row>
        <MudImage Height="180" Width="180" Src="@Node.Image"></MudImage>

        <MudStack AlignItems="AlignItems.Start" Justify="Justify.Center">
            <MudText Typo="Typo.h3">@Node.Title</MudText>
            <MudText Typo="Typo.h6">@Node.Description</MudText>
        </MudStack>
    </MudStack>
</MudCard>

@code {

    [Parameter]
    public NodeModelTechnologyLabel Node { get; set; } = null!;
}