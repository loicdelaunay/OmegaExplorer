<MudTextField @ref="_mudTextField" T="string" ValueChanged="newVal => { OnInheritValueChanged(newVal); }" Variant="Variant" Label="@Label" InputType="@_inputType" OnAdornmentClick="TogglePasswordVisibility" AdornmentIcon="@_passwordInputIcon" AdornmentAriaLabel="Show Password" Immediate="true" Adornment="Adornment.End"></MudTextField>

@code {
    private InputType _inputType = InputType.Password;
    private bool _isShow;
    string _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
    private MudTextField<string> _mudTextField;

    private string _value = default;

    [Parameter]
    public string Label { get; set; } = "Password";

    [Parameter]
    public string Value
    {
        get => _value;
        set
        {
            if (_mudTextField == null)
            {
                Console.WriteLine("inherit child not found into MudPassword");
            }
            else
            {
                _mudTextField.Value = value;
                _mudTextField.ForceRender(true);
            }
            _value = value;
        }
    }

    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    void TogglePasswordVisibility()
    {
        @if (_isShow)
        {
            _isShow = false;
            _passwordInputIcon = Icons.Material.Filled.VisibilityOff;
            _inputType = InputType.Password;
        }
        else
        {
            _isShow = true;
            _passwordInputIcon = Icons.Material.Filled.Visibility;
            _inputType = InputType.Text;
        }
    }

    private async void OnInheritValueChanged(object newVal)
    {
        string value = (string)newVal;
        Value = value;
        await ValueChanged.InvokeAsync(value);
    }

}