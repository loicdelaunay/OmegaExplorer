@using Howler.Blazor.Components
@inject IHowl Howl
@inject IHowlGlobal HowlGlobal

<div style="position:fixed; top: 0px; z-index: 10000000000">
	<MudButton class="btn btn-primary oi oi-media-play" @onclick="Play">Play</MudButton>
	<MudButton class="btn btn-primary oi oi-media-stop" @onclick="Stop">Stop</MudButton>
	<MudButton class="btn btn-primary oi oi-media-pause" @onclick="Pause">Pause</MudButton>
	<pre>TotalTime : @TotalTime</pre>
	<pre>State : @State</pre>
	<pre>Supported Codes : @SupportedCodes</pre>
</div>

@code {
	protected TimeSpan TotalTime;
	protected string State = "-";
	protected string SupportedCodes;
	private int idPlaying;

	protected override async Task OnInitializedAsync()
	{
		// Display all supported codecs
		var codecs = await HowlGlobal.GetCodecs();
		SupportedCodes = string.Join(", ", codecs);

		// Register callbacks
		Howl.OnPlay += e =>
		{
			State = "Playing";
			TotalTime = e.TotalTime;

			StateHasChanged();
		};

		Howl.OnStop += e =>
		{
			State = "Stopped";

			StateHasChanged();
		};

		Howl.OnPause += e =>
		{
			State = "Paused";

			StateHasChanged();
		};
	}

	protected async Task Play()
	{
		idPlaying = await Howl.Play("https://samplelib.com/lib/preview/mp3/sample-9s.mp3?_=1");
	}

	protected async Task Stop()
	{
		await Howl.Stop(idPlaying);
	}

	protected async Task Pause()
	{
		await Howl.Pause(idPlaying);
	}

}