@inject ISnackbar Snackbar;

<MudDialog>
    <DialogContent>
        <MudStack>
            @if (User == null)
            {
                <OmegaMudPasswordField Variant="Variant.Outlined" Label="Old password" @bind-Value="_requestUpdateUserPassword.OldPassword"></OmegaMudPasswordField>
                <MudDivider Class="mb-5 mt-10"></MudDivider>   
            }
            <OmegaMudPasswordField Variant="Variant.Outlined" Label="New password" @bind-Value="_requestUpdateUserPassword.NewPassword"></OmegaMudPasswordField>
            <OmegaMudPasswordField Variant="Variant.Outlined" Label="Confirm new password" @bind-Value="_confirmPassword"></OmegaMudPasswordField>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {

    [CascadingParameter]
    IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public ResponseUser? User { get; set; }

    private readonly RequestUpdateUserPassword _requestUpdateUserPassword = new();

    private string _confirmPassword;

    void Cancel()
    {
        MudDialog.Cancel();
    }

    async void Submit()
    {
        try
        {
            if (_confirmPassword != _requestUpdateUserPassword.NewPassword)
            {
                Snackbar.Add("New password and confirm password is not the same", Severity.Warning);
                return;
            }
            _requestUpdateUserPassword.UserId = User?.Id;

            await ApiManager.Client.UpdatePasswordAsync(_requestUpdateUserPassword);

            Snackbar.Add("Successfully updated password", Severity.Success);
            MudDialog.Close();
        }
        catch (Exception e)
        {
            Console.WriteLine(e.ToString());
            Snackbar.Add("Not able to update the password" + e.Message, Severity.Error);
        }
    }

}